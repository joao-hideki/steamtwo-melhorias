NODE_ENV=development
PORT=3001
# Banco local do docker compose (credenciais apenas de desenvolvimento)
DATABASE_URL=postgres://steamtwo:steamtwo@localhost:5432/steamtwo
# Opcional: testes de integração usam <DATABASE_URL>_test quando esta variável está vazia
TEST_DATABASE_URL=
# Opcional: enriquecimento pela IGDB (o catálogo funciona sem, via loja Steam)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_COUNTRY=BR
EPIC_LOCALE=pt-BR
# Intervalo do serviço `sync` do docker compose
SYNC_INTERVAL_MINUTES=30
